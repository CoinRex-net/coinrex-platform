COINREX_ENV=development

# Public production URL used for canonical tags, sitemap, robots, and emails.
# Example: https://coinrex.xyz
COINREX_PUBLIC_BASE_URL=

# Testing Mode (set to true to bypass cooldowns/security for testing)
COINREX_TESTING_MODE=false
COINREX_CLAIM_PAIRING_TEST_MODE=false

# Database
COINREX_DB_HOST=localhost
COINREX_DB_NAME=koinrex
COINREX_DB_USER=root
COINREX_DB_PASS=

# App secrets
COINREX_CSRF_KEY=change-this-to-a-random-secret
COINREX_ENCRYPTION_KEY=change-this-to-a-random-secret
COINREX_WIDGET_SECRET=change-this-to-a-long-random-secret
COINREX_WIDGET_TOKEN_TTL=86400

# Realtime / REX Signer WebSocket
COINREX_REALTIME_SECRET=change-this-to-a-long-random-realtime-secret
COINREX_REALTIME_WS_PORT=8081
COINREX_REALTIME_EVENT_HOST=127.0.0.1
COINREX_REALTIME_EVENT_PORT=8082
COINREX_REALTIME_EVENT_URL=http://127.0.0.1:8082/events
COINREX_REALTIME_WS_URL=
REXLINK_API_MODE=node
REXLINK_USE_NODE_API=true
REXLINK_API_BASE_URL=
REXLINK_PUBLIC_API_URL=
REXLINK_NODE_PUBLIC_API_URL=
REXLINK_API_PORT=18083

# SMTP / OTP email delivery
COINREX_SMTP_HOST=smtp.gmail.com
COINREX_SMTP_PORT=587
COINREX_SMTP_SECURE=tls
COINREX_SMTP_USERNAME=your-email@example.com
COINREX_SMTP_PASSWORD=your-app-password
COINREX_MAIL_FROM=your-email@example.com
COINREX_MAIL_FROM_NAME="CoinRex No Reply"
COINREX_MAIL_REPLY_TO=support@coinrex.com
COINREX_MAIL_REPLY_TO_NAME="CoinRex Support"

# EVM chain RPC and contract deployment
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
BASE_MAINNET_RPC_URL=https://mainnet.base.org
PLASMA_MAINNET_RPC_URL=
POLYGON_AMOY_PRIVATE_KEY=your-testnet-deployer-private-key-without-0x
REX_CLAIM_SIGNER_PRIVATE_KEY=your-claim-signer-private-key-without-0x
NODE_BINARY=node

# Optional explorer history sync for RexLink wallet activity enrichment
ETHERSCAN_API_KEY=
ETHERSCAN_API_BASE_URL=https://api.etherscan.io/v2/api
