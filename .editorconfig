# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# PHP files
[*.php]
indent_style = space
indent_size = 4

# HTML, CSS, JS, JSON, YAML
[*.{html,htm,css,js,json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# SQL files
[*.sql]
indent_style = space
indent_size = 4

# Composer files
[composer.{json,lock}]
indent_style = space
indent_size = 4

# Shell scripts
[*.{sh,ps1}]
indent_style = space
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
