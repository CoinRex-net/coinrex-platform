RewriteEngine On
DirectoryIndex index.php
Options -Indexes

# Canonical production host for search engines.
RewriteCond %{HTTP_HOST} ^www\.coinrex\.xyz$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?coinrex\.xyz$ [NC]
RewriteRule ^ https://coinrex.xyz%{REQUEST_URI} [R=301,L]

<FilesMatch "^(\.env|\.env\.local|\.cpanel\.yml|composer\.(json|lock|phar)|package(-lock)?\.json|phpunit\.xml\.dist|phpstan\.neon\.dist|phpcs\.xml\.dist|README\.md|CHANGELOG\.md|CONTRIBUTING\.md|SECURITY\.md|error_log)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(zip|tar|gz|rar|sql|bak)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(cache/|contracts/|database/|deployments/|docs/|includes/|node_modules/|realtime/|rex-wallet/|rexlink-service/|scripts/|src/|test/|tests/|tools/|vendor/)

RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

RewriteRule ^blog-post\.php/what-is-blockchain-simple-guide-coinrex-beginners/?$ /blog-post.php/what-is-blockchain-a-simple-guide-for-coinrex-beginners [R=301,L]
RewriteRule ^public/blog-post\.php/what-is-blockchain-simple-guide-coinrex-beginners/?$ /blog-post.php/what-is-blockchain-a-simple-guide-for-coinrex-beginners [R=301,L]

<IfModule mod_php.c>
    php_value session.save_path "C:/xampp/htdocs/coinrex/cache/sessions"
</IfModule>

<IfModule php_module>
    php_value session.save_path "C:/xampp/htdocs/coinrex/cache/sessions"
</IfModule>

# ============================================================
# SEO-friendly blog post URLs
# Rewrite: /blog-post.php/some-slug → /public/blog-post.php?slug=some-slug
# Rewrite: /public/blog-post.php/some-slug → /public/blog-post.php?slug=some-slug
# ============================================================

# Pattern 1: /blog-post.php/slug (from public/*.php links)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog-post\.php/(.+)$ public/blog-post.php?slug=$1 [L,QSA]

# Pattern 2: /public/blog-post.php/slug (from index.php links)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^public/blog-post\.php/(.+)$ public/blog-post.php?slug=$1 [L,QSA]

# ============================================================
# General rule: pass through existing files/directories
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]
