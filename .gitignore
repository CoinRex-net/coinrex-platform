.env
.env.local

# Dependency directories
/vendor/

# RexLink Expo local/generated files. Keep the app source and assets visible to
# Git and EAS; EAS's ignore matcher does not reliably reproduce nested
# allow-lists beneath an ignored parent directory.
/rex-wallet/node_modules/
/rex-wallet/.npm-cache/
/rex-wallet/.expo/
/rex-wallet/.tmp/
/rex-wallet/.tmp-eas-archive/
/rex-wallet/dist/
/rex-wallet/web-build/
/rex-wallet/android/
/rex-wallet/ios/

# Runtime uploads and user-generated content
/uploads/
/assets/uploads/
/uploads/ads/
/uploads/avatar/
/uploads/projects_logo/
/uploads/proofs/
/assets/uploads/avatars/
/devhub/projects/logos/

# Runtime logs
/devhub/logs/*.log
/rexlink-service/*.log

# Local / in-progress RexLink extraction files
/api/rex-signer/
/auth/rexlink_bridge.php
/public/rex-signer.php
/assets/images/rexlink-logo.png
/rexlink-service/*.js
/rexlink-service/*.bat
/rexlink-service/*.ps1
/assets/css/rexlink-*.css
!/assets/css/rexlink-claims.css
/assets/js/rexlink-*.js
!/assets/js/rexlink-auth.js
!/assets/js/rexlink-claims.js
!/assets/js/rexlink-pairing.js
/docs/REXLINK_ARCHITECTURE.md
/config/rex-signer-networks.local.php*
/rexlink-service/lib/
/rexlink-service/routes/
/rexlink-service/services/

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp
*.temp

# Local archives / dumps
*.zip
*.tar
*.gz
*.rar
*.sql.bak

# Composer phar binary (installer / runtime)
/composer.phar
/tools/composer.phar

# AI assistant working directory (contains API keys)
.continue/

# Live environment file (contains real credentials)
.env
.env.local

# PHPUnit cache
.phpunit.cache/

# PHPStan cache
.tmp/

# Hardhat / smart-contract output
/artifacts/
/cache/
/node_modules/
/deployments/*.json

# Composer lock (not needed for libraries, but keep for project)
# composer.lock

# Tools output
tools/*.log
tools/*.sql
tools/cookie.txt
tools/debug_*.html
tools/debug_*.php
tools/login_*.html
tools/taskhub_admin.html
node_modules
